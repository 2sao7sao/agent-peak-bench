{
  "suite_name": "tool_count_ablation",
  "description": "Measure whether performance changes because of tool count, tool distractors, or both.",
  "scenarios": [
    {
      "id": "tool-count-3",
      "title": "Focused tool surface",
      "category": "tool_ablation",
      "repeat": 3,
      "system": "You are a debugging agent. Use tools before concluding. Final answer must include Cause and Fix.",
      "messages": [
        {
          "role": "user",
          "content": "定位为什么 webhook 任务失败。"
        }
      ],
      "tools": [
        {
          "name": "read_log",
          "description": "Read the service log.",
          "input_schema": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        {
          "name": "read_config",
          "description": "Read the service config.",
          "input_schema": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        {
          "name": "read_runbook",
          "description": "Read the recovery runbook.",
          "input_schema": {
            "type": "object",
            "properties": {},
            "required": []
          }
        }
      ],
      "mock_tools": {
        "read_log": {
          "error": "certificate expired on webhook gateway"
        },
        "read_config": {
          "tls_rotation": "disabled"
        },
        "read_runbook": {
          "action": "rotate certificate and re-enable tls rotation"
        }
      },
      "max_tool_rounds": 3,
      "max_tokens": 320,
      "expected": {
        "must_contain": [
          "Cause",
          "Fix",
          "certificate expired",
          "tls rotation"
        ],
        "required_tool_names": [
          "read_log",
          "read_runbook"
        ]
      }
    },
