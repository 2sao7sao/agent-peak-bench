      },
      "max_tool_rounds": 5,
      "max_tokens": 1150,
      "expected": {
        "required_tool_names": ["mcp_ads_metrics", "mcp_inventory_check", "mcp_support_digest", "mcp_logistics_status"],
        "required_tool_name_groups": [["mcp_email_campaign_draft", "mcp_support_digest"]],
        "json_keys": ["task_interpretation", "evidence", "decision", "actions", "risks", "harness_notes"],
        "json_key_contains": {
