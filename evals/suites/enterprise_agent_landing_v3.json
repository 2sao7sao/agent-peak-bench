        "json_key_contains": {
          "decision": ["risk"],
          "evidence": ["-38%", "SUP-9012", "downgrade"],
          "actions": ["Dana", "SSO"],
          "risks": ["renewal"]
        },
        "must_not_contain": ["relationship is fine", "no risk"]
      },
      "capability_items": [
        "cross_system_synthesis",
        "contradictory_signal_resolution",
        "business_decision_support",
        "evidence_weighting"
      ],
      "harness_hypothesis": "CRM optimism must be checked against usage, support, and customer communication signals.",
      "failure_taxonomy": ["single_source_bias", "crm_overtrust", "missing_support_signal", "missing_usage_signal", "weak_decision"]
    },
    {
