{
  "suite_name": "enterprise_agent_landing_v3",
  "version": "2026-05-06",
  "benchmark_family": "long_running_harness",
  "description": "Realistic enterprise-agent landing tasks. These scenarios test implicit intent, tool-grounded evidence, governance, planning, cross-system synthesis, and end-to-end decision quality.",
  "default_repeat": 7,
  "scenarios": [
    {
      "id": "ent-security-review-prep-implicit-intent",
      "title": "Implicit customer security review preparation",
      "category": "enterprise_knowledge_agent",
      "benchmark_family": "structured_workflow",
      "repeat": 7,
      "temperature": 0.2,
      "system": "You are an enterprise knowledge agent. Infer the user's business intent, use tools before answering, distinguish evidence from gaps, and return valid JSON only with keys task_interpretation, evidence, decision, actions, risks, harness_notes. Use concise English values.",
      "messages": [
        {
          "role": "user",
          "content": "明天 Acme 的安全评审会很刁，CTO 只发了句「别再让销售现场翻文档」。你直接帮我准备能拿去用的材料，别写泛泛的安全宣传稿。"
        }
      ],
      "tools": [
        {
          "name": "mcp_drive_search",
          "description": "Search internal Drive documents by query.",
          "input_schema": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}
        },
        {
          "name": "mcp_drive_read",
          "description": "Read a document by id.",
          "input_schema": {"type": "object", "properties": {"doc_id": {"type": "string"}}, "required": ["doc_id"]}
        },
        {
          "name": "mcp_ticket_search",
          "description": "Search customer tickets and incidents.",
          "input_schema": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}
        },
        {
          "name": "mcp_owner_lookup",
          "description": "Find accountable owners for security, compliance, or product areas.",
          "input_schema": {"type": "object", "properties": {"area": {"type": "string"}}, "required": ["area"]}
        }
      ],
      "mock_tools": {
        "mcp_drive_search": {
          "results": [
            {"doc_id": "sec-2026-q2", "title": "Security Review Pack Q2", "signals": ["SOC 2 Type II", "data residency", "subprocessor list"]},
            {"doc_id": "acme-redlines", "title": "Acme Security Redlines", "signals": ["EU data residency", "audit log retention", "DPA"]}
          ]
        },
        "mcp_drive_read": {
          "doc_id": "sec-2026-q2",
          "facts": [
            "SOC 2 Type II report is current through 2026-03-31.",
            "EU data residency is supported only for Enterprise plan tenants.",
            "Audit logs are retained for 365 days unless extended retention is purchased."
          ]
        },
        "mcp_ticket_search": {
          "tickets": [
            {"id": "ACME-1842", "issue": "Acme asked whether EU tenant data can be excluded from US analytics jobs.", "status": "open"},
            {"id": "ACME-1779", "issue": "Acme requested subprocessor export for legal review.", "status": "resolved"}
          ]
        },
        "mcp_owner_lookup": {
          "security": "Lena Ortiz",
          "legal": "Maya Chen",
          "product": "Noah Singh"
        }
      },
      "max_tool_rounds": 4,
      "max_tokens": 1100,
      "expected": {
        "required_tool_names": ["mcp_drive_search", "mcp_ticket_search", "mcp_owner_lookup"],
        "required_tool_name_groups": [["mcp_drive_read", "mcp_drive_search"]],
        "min_tool_calls": 3,
        "max_tool_calls": 6,
        "json_keys": ["task_interpretation", "evidence", "decision", "actions", "risks", "harness_notes"],
        "json_key_contains": {
          "task_interpretation": ["security review"],
          "evidence": ["SOC 2", "EU data residency", "ACME-1842"],
          "actions": ["Lena", "Maya"],
          "risks": ["open"]
        },
        "must_contain_any": [
          {"name": "anti_generic_marketing", "options": ["redline", "specific", "客户", "Acme"]},
          {"name": "evidence_gap", "options": ["missing", "缺口", "open", "待确认"]}
        ]
      },
      "capability_items": [
        "implicit_intent_inference",
        "enterprise_knowledge_retrieval",
        "evidence_synthesis",
        "gap_honesty",
        "owner_routing"
      ],
      "harness_hypothesis": "A model should not answer from generic security knowledge. It must retrieve internal documents, customer-specific tickets, and accountable owners before producing a usable prep pack.",
      "failure_taxonomy": ["intent_miss", "tool_avoidance", "generic_answer", "evidence_gap_hidden", "owner_missing"]
    },
    {
      "id": "ent-renewal-risk-cross-system",
